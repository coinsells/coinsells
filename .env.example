# Telegram bot token from BotFather — keep secret, never commit real values
TELEGRAM_BOT_TOKEN=

# Telegram numeric user IDs allowed to review orders, comma-separated
TELEGRAM_ADMIN_IDS=

# Public Telegram channel username (the bot must be an administrator to post)
PUBLIC_CHANNEL_USERNAME=@coinsells

# Public TRON address receiving USDT TRC20
USDT_TRC20_ADDRESS=
# Official USDT TRC20 contract on TRON
USDT_TRC20_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_API_BASE=https://api.trongrid.io
# Optional; recommended for reliable rate limits
TRON_API_KEY=

# PostgreSQL async SQLAlchemy URL, e.g. postgresql+asyncpg://user:password@host:5432/coinsells
DATABASE_URL=
# Optional Redis URL for FSM state persistence, e.g. redis://localhost:6379/0
REDIS_URL=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ENCRYPTION_KEY=

# Indicative conversion rate. Confirm your actual USD pricing policy before use.
USD_PER_USDT=1.0
EXCHANGE_FEE_PERCENT=1.0
MIN_USDT=1000
MAX_USDT=10000000
